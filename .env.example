# Copie para .env e preencha. O .env nunca vai para o git.

# Chave da Elsevier (https://dev.elsevier.com). Obrigatória para a Scopus.
SCOPUS_API_KEY=

# Token institucional da Elsevier. Opcional: sem ele, os resumos (META_ABS)
# e as referências (REF) só vêm quando a requisição sai de um IP da instituição.
SCOPUS_INST_TOKEN=

# Se estiver fora da rede da universidade, encaminhe as requisições por um
# túnel SOCKS que saia por um IP institucional (ver README, seção "Acesso à Scopus").
# HTTPS_PROXY=socks5h://127.0.0.1:1080
